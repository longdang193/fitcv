"<!DOCTYPE html>\n\n<html lang=\"en\">\n<head>\n  <!-- Apply saved theme before CSS renders — prevents flash -->\n  <script>\n    (function() {\n      var t = localStorage.getItem('fitcv-theme') || 'dark';\n      document.documentElement.setAttribute('data-theme', t);\n    })();\n  </script>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Run b11444de — FitCV Admin</title>\n  <style>\n    /* ── CSS Custom Properties (tokens) ──────────────────────────────────── */\n    :root[data-theme=\"dark\"] {\n      --bg:          #0f1117;\n      --surface-1:   #1a1d2e;\n      --surface-2:   #1e2235;\n      --border:      #2d3148;\n      --border-soft: #1e2235;\n      --text-primary:   #e2e8f0;\n      --text-secondary: #94a3b8;\n      --text-muted:     #64748b;\n      --accent:      #6366f1;\n      --accent-hover:#4f46e5;\n      --accent-dim:  #312e81;\n      --accent-text: #a5b4fc;\n      --success-fg:  #4ade80;\n      --badge-success-bg: #14532d; --badge-success-fg: #4ade80;\n      --badge-error-bg:   #450a0a; --badge-error-fg:   #f87171;\n      --badge-warning-bg: #422006; --badge-warning-fg: #fb923c;\n      --badge-info-bg:    #1e3a5f; --badge-info-fg:    #60a5fa;\n      --badge-neutral-bg: #334155; --badge-neutral-fg: #94a3b8;\n      --table-header-bg: var(--surface-2);\n      --table-row-hover: #1a1e30;\n      --input-bg:    var(--surface-2);\n      --code-bg:     #0f0f1a;\n      --code-color:  #c7d2fe;\n      --code-border: #312e81;\n      --divider:     #1e293b;\n    }\n    :root[data-theme=\"light\"] {\n      --bg:          #f8fafc;\n      --surface-1:   #ffffff;\n      --surface-2:   #f1f5f9;\n      --border:      #e2e8f0;\n      --border-soft: #f1f5f9;\n      --text-primary:   #0f172a;\n      --text-secondary: #475569;\n      --text-muted:     #94a3b8;\n      --accent:      #4f46e5;\n      --accent-hover:#3730a3;\n      --accent-dim:  #e0e7ff;\n      --accent-text: #4338ca;\n      --success-fg:  #166534;\n      --badge-success-bg: #dcfce7; --badge-success-fg: #166534;\n      --badge-error-bg:   #fee2e2; --badge-error-fg:   #991b1b;\n      --badge-warning-bg: #ffedd5; --badge-warning-fg: #9a3412;\n      --badge-info-bg:    #dbeafe; --badge-info-fg:    #1e40af;\n      --badge-neutral-bg: #f1f5f9; --badge-neutral-fg: #475569;\n      --table-header-bg: #f8fafc;\n      --table-row-hover: #f1f5f9;\n      --input-bg:    #ffffff;\n      --code-bg:     #f1f5f9;\n      --code-color:  #4338ca;\n      --code-border: #c7d2fe;\n      --divider:     #e2e8f0;\n    }\n\n    /* ── Reset & base ─────────────────────────────────────────────────────── */\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: 'Inter', system-ui, sans-serif;\n      background: var(--bg);\n      color: var(--text-primary);\n      min-height: 100vh;\n    }\n\n    /* ── Navigation ───────────────────────────────────────────────────────── */\n    nav {\n      background: var(--surface-1);\n      border-bottom: 1px solid var(--border);\n      padding: 0 2rem;\n      height: 56px;\n      display: flex;\n      align-items: center;\n      gap: 1.5rem;\n    }\n    nav a {\n      color: var(--text-secondary);\n      text-decoration: none;\n      font-size: 0.9rem;\n      font-weight: 500;\n      transition: color 0.15s;\n    }\n    nav a:hover { color: var(--text-primary); }\n    .brand { color: var(--accent); font-weight: 700; font-size: 1.05rem; }\n    .nav-actions {\n      margin-left: auto;\n      display: flex;\n      align-items: center;\n      gap: 0.75rem;\n    }\n\n    /* ── Layout ───────────────────────────────────────────────────────────── */\n    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }\n    h1 { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.5rem; }\n    h2 { font-size: 1.1rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 1rem; }\n    .page-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 1.5rem;\n      gap: 1rem;\n      flex-wrap: wrap;\n    }\n    .page-header h1 { margin-bottom: 0; }\n\n    /* ── Card & section ───────────────────────────────────────────────────── */\n    .card, .section-card {\n      background: var(--surface-1);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 1.5rem;\n      margin-bottom: 1.5rem;\n    }\n    .section-title  { font-size: 1rem; font-weight: 600; color: var(--text-primary); }\n    .section-helper { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }\n    .section-actions {\n      display: flex;\n      justify-content: flex-end;\n      margin-top: 1rem;\n      gap: 0.5rem;\n      flex-wrap: wrap;\n    }\n\n    /* ── Sub-card (grouped sibling forms inside a section-card) ─────────────── */\n    /* Used by the three ranking groups inside the Ranking section.              */\n    .sub-card {\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      background: var(--surface-1);\n      margin-bottom: 1rem;\n      overflow: hidden;\n    }\n    /* Last sub-card in a group: no bottom margin (flush with section bottom) */\n    .sub-card:last-child {\n      margin-bottom: 0;\n    }\n    .sub-card-header {\n      padding: 0.75rem 1rem 0;\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      gap: 0.5rem;\n    }\n    .sub-card-title {\n      font-size: 0.9rem;\n      font-weight: 600;\n      color: var(--text-primary);\n    }\n    .sub-card-helper {\n      font-size: 0.75rem;\n      color: var(--text-muted);\n      margin-top: 0.2rem;\n    }\n    .sub-card-body {\n      padding: 0.75rem 1rem;\n    }\n    /* Pairs label + value in a row (scoped to sub-card internals — does not\n       override the existing .kv shared rule used by run-detail metadata grids) */\n    .sub-card .kv { display: grid; grid-template-columns: 12rem 1fr; gap: 0.25rem 0.5rem; font-size: 0.8rem; }\n    .sub-card-footer {\n      padding: 0.75rem 1rem;\n      border-top: 1px solid var(--border-soft);\n      display: flex;\n      justify-content: flex-end;\n      gap: 0.5rem;\n    }\n\n    /* ── Inspection card with attached tab bar ────────────────────────────────── */\n    /* Used by the run-detail inspection area.                                      */\n    /* One shared container for tab bar + pane body.                               */\n    .inspection-card {\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      background: var(--surface-1);\n      overflow: hidden;\n      margin-bottom: 1.5rem;\n    }\n\n    /* Tab bar sits flush on the top edge of the inspection card.                   */\n    .tab-bar--attached {\n      display: flex;\n      align-items: center;\n      gap: 0;\n      border-bottom: 1px solid var(--border);\n      background: var(--surface-1);\n      padding: 0 0.75rem;\n    }\n    .tab-bar--attached .tab-btn {\n      padding: 0.6rem 1rem;\n      font-size: 0.85rem;\n      color: var(--text-secondary);\n      background: transparent;\n      border: none;\n      border-bottom: 2px solid transparent;\n      cursor: pointer;\n      transition: color 0.15s, border-color 0.15s;\n      margin-bottom: -1px;    /* overlaps the card top border */\n    }\n    .tab-bar--attached .tab-btn:hover {\n      color: var(--text-primary);\n    }\n    .tab-bar--attached .tab-btn.active {\n      color: var(--accent);\n      border-bottom-color: var(--accent);\n      font-weight: 600;\n    }\n\n    /* Pane container — one consistent border/radius/padding for all three panes.  */\n    .pane-container {\n      border: none;\n      border-top: none;\n      background: var(--surface-1);\n      padding: 1rem;\n    }\n    /* Default: hidden; .active: shown */\n    .pane-container.tab-pane {\n      display: none;\n    }\n    .pane-container.tab-pane.active {\n      display: block;\n    }\n    .pane-container .card { padding: 0; border: none; }\n    /* ── Table ────────────────────────────────────────────────────────────── */\n    table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }\n    th {\n      background: var(--table-header-bg);\n      color: var(--text-muted);\n      font-weight: 600;\n      text-align: left;\n      padding: 0.65rem 1rem;\n      border-bottom: 1px solid var(--border);\n      text-transform: uppercase;\n      font-size: 0.7rem;\n      letter-spacing: 0.05em;\n    }\n    td { padding: 0.7rem 1rem; border-bottom: 1px solid var(--border-soft); color: var(--text-secondary); }\n    tr:hover td { background: var(--table-row-hover); }\n    .empty-row td { color: var(--text-muted); text-align: center; padding: 2rem; }\n\n    /* ── Links ────────────────────────────────────────────────────────────── */\n    a { color: var(--accent); text-decoration: none; }\n    a:hover { text-decoration: underline; }\n\n    /* ── Buttons ──────────────────────────────────────────────────────────── */\n    /* Primary — main CTA (Trigger Run, grouped ranking saves) */\n    .btn-primary {\n      background: var(--accent);\n      color: #fff;\n      border: none;\n      padding: 0.5rem 1.1rem;\n      border-radius: 6px;\n      font-size: 0.875rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: background 0.15s;\n    }\n    .btn-primary:hover { background: var(--accent-hover); }\n\n    /* Secondary — supporting actions (Refresh, theme toggle, mode tabs) */\n    .btn-secondary {\n      background: transparent;\n      color: var(--text-secondary);\n      border: 1px solid var(--border);\n      padding: 0.4rem 0.9rem;\n      border-radius: 6px;\n      font-size: 0.875rem;\n      font-weight: 500;\n      cursor: pointer;\n      transition: all 0.15s;\n    }\n    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }\n    .btn-secondary[data-active=\"true\"] {\n      background: var(--accent-dim);\n      border-color: var(--accent);\n      color: var(--accent-text);\n      font-weight: 600;\n    }\n\n    /* Section — settings section saves (Save Retrieval Settings, etc.) */\n    .btn-section {\n      background: var(--surface-2);\n      color: var(--accent);\n      border: 1px solid var(--border);\n      padding: 0.45rem 1rem;\n      border-radius: 6px;\n      font-size: 0.875rem;\n      font-weight: 500;\n      cursor: pointer;\n      transition: all 0.15s;\n    }\n    .btn-section:hover { background: var(--accent); color: #fff; border-color: var(--accent); }\n\n    /* Legacy fallback — default button style (same as primary) */\n    button { background: var(--accent); color: #fff; border: none; padding: 0.5rem 1.1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: background 0.15s; }\n    button:hover { background: var(--accent-hover); }\n\n    /* ── Badges ───────────────────────────────────────────────────────────── */\n    .badge {\n      display: inline-block;\n      font-size: 0.7rem;\n      font-weight: 600;\n      padding: 0.2rem 0.55rem;\n      border-radius: 99px;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n    }\n    .badge-queued    { background: var(--badge-neutral-bg); color: var(--badge-neutral-fg); }\n    .badge-running   { background: var(--badge-info-bg);    color: var(--badge-info-fg); }\n    .badge-succeeded { background: var(--badge-success-bg); color: var(--badge-success-fg); }\n    .badge-failed    { background: var(--badge-error-bg);   color: var(--badge-error-fg); }\n    .badge-info      { background: var(--badge-info-bg);    color: var(--badge-info-fg); }\n    .badge-warning   { background: var(--badge-warning-bg); color: var(--badge-warning-fg); }\n    .badge-error     { background: var(--badge-error-bg);   color: var(--badge-error-fg); }\n\n    /* ── Forms & inputs ───────────────────────────────────────────────────── */\n    input[type=\"text\"],\n    input[type=\"number\"],\n    input[type=\"file\"],\n    textarea,\n    select {\n      background: var(--input-bg);\n      border: 1px solid var(--border);\n      color: var(--text-primary);\n      padding: 0.5rem 0.85rem;\n      border-radius: 6px;\n      font-size: 0.875rem;\n      outline: none;\n    }\n    input[type=\"text\"]   { width: 360px; }\n    input[type=\"number\"] { width: 96px; }\n    textarea { width: 100%; }\n    input:focus, textarea:focus, select:focus { border-color: var(--accent); }\n    *:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n    /* ── Code ─────────────────────────────────────────────────────────────── */\n    code, .code-area {\n      background: var(--code-bg);\n      color: var(--code-color);\n      border: 1px solid var(--code-border);\n      border-radius: 6px;\n      font-size: 0.8rem;\n      font-family: monospace;\n    }\n    code { padding: 0.1rem 0.35rem; }\n    .code-area { padding: 0.5rem; }\n\n    /* ── State helpers ────────────────────────────────────────────────────── */\n    .meta          { font-size: 0.8rem; color: var(--text-muted); }\n    .current-value { color: var(--success-fg); font-weight: 600; }\n    .empty-value   { color: var(--text-muted); }\n    .field-error   { font-size: 0.78rem; color: var(--badge-error-fg); margin-top: 0.2rem; }\n\n    /* ── Error box ──────────────────────────────────────────────────────────*/\n    .error-box {\n      background: var(--badge-error-bg);\n      border: 1px solid var(--badge-error-fg);\n      border-radius: 8px;\n      padding: 1rem 1.25rem;\n      margin-bottom: 1.25rem;\n    }\n    .error-box strong { color: var(--badge-error-fg); display: block; margin-bottom: 0.35rem; }\n\n    /* ── KV grid ──────────────────────────────────────────────────────────── */\n    .kv { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1.25rem; font-size: 0.875rem; }\n    .kv .k { color: var(--text-muted); }\n    .kv .v { color: var(--text-primary); font-weight: 500; }\n\n    /* ── Divider ──────────────────────────────────────────────────────────── */\n    hr { border: none; border-top: 1px solid var(--divider); margin: 1rem 0; }\n\n    /* ── Details / summary ────────────────────────────────────────────────── */\n    /* Hide browser-native disclosure triangle — we use our own ▾ character. */\n    details > summary { list-style: none; cursor: pointer; }\n    details > summary::-webkit-details-marker { display: none; }\n\n    /* ── Tab bar ──────────────────────────────────────────────────────────── */\n    .tab-bar { display: flex; gap: 0.5rem; margin-bottom: 0; border-bottom: 2px solid var(--border); padding-bottom: 0; }\n    .tab-btn {\n      background: var(--surface-2); color: var(--text-muted);\n      border: 1px solid var(--border); border-bottom: none;\n      border-radius: 6px 6px 0 0;\n      padding: 0.5rem 1rem; font-size: 0.85rem; cursor: pointer;\n      transition: all 0.15s; position: relative; top: 2px;\n    }\n    .tab-btn:hover { background: var(--surface-1); color: var(--text-primary); }\n    .tab-btn.active { background: var(--surface-1); color: var(--accent-text); border-color: var(--accent); border-bottom-color: var(--surface-1); }\n    .tab-pane { display: none; }\n    .tab-pane.active { display: block; }\n    .tab-pane > .card { border-top-left-radius: 0; border-top: none; }\n\n    /* ── Results card ─────────────────────────────────────────────────────── */\n    .results-card {\n      background: var(--accent-dim); border: 1px solid var(--accent);\n      border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem;\n    }\n    .results-card h3 { color: var(--accent-text); font-size: 1.05rem; margin: 0 0 0.5rem; }\n    .cv-row {\n      display: flex; align-items: center; justify-content: space-between;\n      background: var(--surface-1); border: 1px solid var(--accent);\n      padding: 0.6rem 0.8rem; border-radius: 6px;\n    }\n\n    /* ── Responsive ───────────────────────────────────────────────────────── */\n    @media (max-width: 768px) {\n      .container { padding: 1rem; }\n      .page-header { flex-direction: column; align-items: flex-start; }\n      nav { padding: 0 1rem; gap: 1rem; }\n      table { display: block; overflow-x: auto; }\n    }\n  </style>\n</head>\n<body>\n  <nav>\n    <span class=\"brand\">⚡ FitCV Admin</span>\n    <a href=\"/admin/runs\">Runs</a>\n    <a href=\"/admin/settings\">Settings</a>\n    <a href=\"/healthz\">Health</a>\n    <div class=\"nav-actions\">\n      <button class=\"btn-secondary\" id=\"theme-toggle\" aria-label=\"Toggle theme\" onclick=\"toggleTheme()\">\n        <span id=\"theme-icon\">☀️</span> <span id=\"theme-label\">Light</span>\n      </button>\n    </div>\n  </nav>\n  <div class=\"container\">\n    \n\n<div class=\"page-header\">\n  <h1>Run <code>b11444de-514d-4f04-aaef-9db912662adf</code></h1>\n  <div style=\"display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap\">\n    \n    \n    <a href=\"/admin/runs/b11444de-514d-4f04-aaef-9db912662adf\" class=\"btn-secondary\" id=\"manual-refresh-link\">⟳ Refresh Status</a>\n    <a href=\"/admin/runs\" class=\"btn-secondary\">← All Runs</a>\n  </div>\n</div>\n\n<!-- ── Run Metadata Card ─────────────────────────────────────────────────── -->\n<div class=\"card\">\n  <div style=\"display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem\">\n    <span class=\"badge badge-awaiting_continue\">awaiting_continue</span>\n    <span class=\"badge badge-info\">Run All</span>\n    \n  </div>\n  <div class=\"kv\">\n    <span class=\"k\">Triggered By</span><span class=\"v\">codex</span>\n    <span class=\"k\">Run Mode</span><span class=\"v\">Run All</span>\n    <span class=\"k\">Jobs Path</span><span class=\"v\"><code>data/sample_jobs.json</code></span>\n    \n    <span class=\"k\">Jobs Source</span><span class=\"v\"><span class=\"badge badge-info\">path</span></span>\n    \n    <span class=\"k\">Config</span><span class=\"v\"><code>config/env.yaml</code></span>\n    \n    <span class=\"k\">Pr