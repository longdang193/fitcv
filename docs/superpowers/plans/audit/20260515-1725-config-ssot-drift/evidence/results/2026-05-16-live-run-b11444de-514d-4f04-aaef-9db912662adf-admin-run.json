td class=\"meta\" style=\"max-width:600px;word-break:break-word\">Synonym triage refresh completed: triaged=5, reused=0, fallback=0, skipped=0, failed=0</td>\n        <td class=\"meta\">\n          \n          <span class=\"empty-value\">—</span>\n          \n        </td>\n      </tr>\n      \n    </tbody>\n  </table>\n</div>\n\n<div style=\"display:flex;justify-content:flex-end;margin-top:0.75rem\">\n  <a href=\"/admin/runs/b11444de-514d-4f04-aaef-9db912662adf?timeline_limit=50\" class=\"btn-secondary\">Load older events</a>\n</div>\n\n\n<script>\nfunction showTab(id) {\n  document.querySelectorAll('.tab-pane').forEach(p => {\n    p.style.display = 'none';\n    p.classList.remove('active');\n  });\n  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n  const pane = document.getElementById('pane-' + id);\n  pane.style.display = 'block';\n  pane.classList.add('active');\n  document.getElementById('tab-btn-' + id).classList.add('active');\n  ensureTabLoaded(id);\n}\n\nasync function ensureTabLoaded(id, overrideUrl = null) {\n  const pane = document.getElementById('pane-' + id);\n  if (!pane) return;\n  const url = overrideUrl || pane.dataset.tabUrl;\n  if (!url || pane.dataset.loading === 'true') return;\n  if (!overrideUrl && pane.dataset.loaded === 'true') return;\n  pane.dataset.loading = 'true';\n  if (pane.dataset.loaded !== 'true') {\n    pane.innerHTML = '<div class=\"card tab-loading-state\"><p class=\"meta\">Loading…</p></div>';\n  }\n  try {\n    const resp = await fetch(url, {\n      headers: { 'Accept': 'text/html', 'X-Requested-With': 'fitcv-tab-fragment' },\n      cache: 'no-store',\n    });\n    if (!resp.ok) throw new Error('Failed to load tab');\n    pane.innerHTML = await resp.text();\n    pane.dataset.loaded = 'true';\n  } catch (err) {\n    pane.innerHTML = '<div class=\"card\"><p class=\"field-error\">Could not load this tab right now.</p></div>';\n  } finally {\n    pane.dataset.loading = 'false';\n  }\n}\n\nfunction submitRunDetailTabForm(event, tabId, form) {\n  event.preventDefault();\n  const url = new URL(form.action, window.location.origin);\n  const params = new URLSearchParams();\n  for (const [key, value] of new FormData(form).entries()) {\n    if (value !== null && String(value).length > 0) {\n      params.set(key, String(value));\n    }\n  }\n  const target = url.pathname + (params.toString() ? '?' + params.toString() : '');\n  ensureTabLoaded(tabId, target);\n  return false;\n}\n\ndocument.addEventListener('click', event => {\n  const link = event.target.closest('[data-tab-fragment-url]');\n  if (!link) return;\n  event.preventDefault();\n  const tabId = link.dataset.tabId || link.closest('.tab-pane')?.dataset.tabId;\n  if (!tabId) return;\n  ensureTabLoaded(tabId, link.dataset.tabFragmentUrl);\n});\n\nasync function lifecycleAction(runId, action, btn) {\n  btn.disabled = true;\n  const origText = btn.textContent;\n  btn.textContent = '…';\n  try {\n    const resp = await fetch('/admin/runs/' + runId + '/' + action, { method: 'POST' });\n    if (resp.ok) {\n      location.reload();\n    } else {\n      const body = await resp.json().catch(() => ({ detail: resp.statusText }));\n      let banner = document.getElementById('lifecycle-error-banner');\n      if (!banner) {\n        banner = document.createElement('div');\n        banner.id = 'lifecycle-error-banner';\n        banner.style.cssText = 'position:fixed;top:1rem;left:50%;transform:translateX(-50%);background:var(--badge-error-bg);color:var(--badge-error-fg);border:1px solid var(--badge-error-fg);padding:0.75rem 1.5rem;border-radius:8px;z-index:9999;font-size:0.9rem';\n        document.body.appendChild(banner);\n      }\n      banner.textContent = '⚠ ' + (body.detail || 'Action failed');\n      setTimeout(() => { if (banner) banner.remove(); }, 4000);\n      btn.disabled = false;\n      btn.textContent = origText;\n    }\n  } catch (e) {\n    btn.disabled = false;\n    btn.textContent = origText;\n  }\n}\n\n(function autoRefreshRunDetail() {\n   const liveStatuses = new Set(['queued', 'running', 'cancelling']);\n   const currentStatus = 'awaiting_continue';\n   if (!liveStatuses.has(currentStatus)) return;\n   const runId = 'b11444de-514d-4f04-aaef-9db912662adf';\n   const pollIntervalMs = 15000;\n   const currentLastCompleted = 'cv_generation';\n   const currentNextStage = '';\n   const currentCheckpoint = 'awaiting_review';\n   const currentFinishedAt = '';\n   let pollTimer = null;\n   let inFlight = false;\n\n  function scheduleNextPoll(delayMs = pollIntervalMs) {\n    if (pollTimer) {\n      window.clearTimeout(pollTimer);\n    }\n    pollTimer = window.setTimeout(poll, delayMs);\n  }\n\n  async function poll() {\n    if (document.visibilityState === 'hidden') {\n      scheduleNextPoll();\n      return;\n    }\n    if (inFlight) {\n      scheduleNextPoll();\n      return;\n    }\n    inFlight = true;\n    try {\n      const resp = await fetch('/runs/' + runId, {\n        headers: { 'Accept': 'application/json' },\n        cache: 'no-store',\n      });\n      if (!resp.ok) return;\n      const payload = await resp.json();\n      const nextStatus = payload.status || '';\n      const nextLastCompleted = payload.last_completed_stage || '';\n      const nextNextStage = payload.next_stage || '';\n      const nextCheckpoint = payload.checkpoint_status || '';\n      const nextFinishedAt = payload.finished_at || '';\n      if (\n        nextStatus !== currentStatus ||\n        nextLastCompleted !== currentLastCompleted ||\n        nextNextStage !== currentNextStage ||\n        nextCheckpoint !== currentCheckpoint ||\n        nextFinishedAt !== currentFinishedAt\n      ) {\n        window.location.reload();\n      }\n    } catch (e) {\n      // Keep polling quiet; manual refresh remains available.\n    } finally {\n      inFlight = false;\n      scheduleNextPoll();\n    }\n  }\n\n  document.addEventListener('visibilitychange', () => {\n    if (document.visibilityState === 'visible') {\n      scheduleNextPoll(1000);\n    }\n  });\n\n  scheduleNextPoll();\n})();\n</script>\n\n<style>\n.run-export-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fit, minmax(14rem, 1fr));\n  gap:0.75rem;\n}\n\n.run-export-link {\n  display:flex;\n  align-items:center;\n  gap:0.5rem;\n  padding:0.7rem 0.9rem;\n  border:1px solid var(--accent);\n  border-radius:10px;\n  background:rgba(255,255,255,0.02);\n  text-decoration:none;\n}\n\n.run-export-item {\n  display:flex;\n  flex-direction:column;\n}\n\n.run-health-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fit, minmax(16rem, 1fr));\n  gap:0.85rem;\n}\n\n.run-health-tile {\n  padding:0.9rem 1rem;\n  border:1px solid var(--accent);\n  border-radius:12px;\n  background:rgba(255,255,255,0.02);\n}\n\n.run-health-success {\n  border-color:rgba(46, 204, 113, 0.45);\n  background:rgba(46, 204, 113, 0.08);\n}\n\n.run-health-warning {\n  border-color:rgba(243, 156, 18, 0.45);\n  background:rgba(243, 156, 18, 0.08);\n}\n\n.run-health-error {\n  border-color:rgba(231, 76, 60, 0.45);\n  background:rgba(231, 76, 60, 0.08);\n}\n\n.run-health-info {\n  border-color:rgba(52, 152, 219, 0.35);\n  background:rgba(52, 152, 219, 0.06);\n}\n\n.run-health-muted {\n  border-color:rgba(255, 255, 255, 0.08);\n  background:rgba(255,255,255,0.02);\n}\n\n.run-health-label {\n  font-weight:600;\n  margin-bottom:0.2rem;\n}\n\n.fit-context-stack {\n  display:flex;\n  flex-direction:column;\n  gap:0.2rem;\n  min-width:11rem;\n}\n\n.tab-loading-state {\n  min-height:8rem;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  text-align:center;\n}\n\n.enr-table th {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  background: var(--table-header-bg, var(--card-bg, #1a1b2e));\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', () => {\n  window.setTimeout(() => ensureTabLoaded('enriched'), 50);\n  const applyRecommendationsBtn = document.getElementById('apply-recommendations-btn');\n  const applyRecommendationsStatus = document.getElementById('apply-recommendations-status');\n  const promoteSelectAllBtn = document.getElementById('promote-select-all-btn');\n  const promoteClearAllBtn = document.getElementById('promote-clear-all-btn');\n  const promoteSelectedCount = document.getElementById('promote-selected-count');\n  const promoteControls = document.getElementById('promote-controls');\n  const promoteEmptyNote = document.getElementById('promote-empty-note');\n  const promoteCheckboxes = () => Array.from(document.querySelectorAll('input[type=\"checkbox\"][name=\"promote_proposal_id\"][data-promote-selectable=\"true\"]'));\n\n  const refreshPromoteSelectedCount = () => {\n    if (!promoteSelectedCount) {\n      return;\n    }\n    const selected = promoteCheckboxes().filter((cb) => cb.checked).length;\n    promoteSelectedCount.textContent = `Selected: ${selected}`;\n  };\n\n  const promoteRows = promoteCheckboxes();\n  if (promoteControls && promoteEmptyNote) {\n    if (promoteRows.length === 0) {\n      promoteControls.style.display = 'none';\n      promoteEmptyNote.style.display = '';\n    } else {\n      promoteControls.style.display = 'flex';\n      promoteEmptyNote.style.display = 'none';\n    }\n  }\n\n  promoteRows.forEach((checkboxEl) => {\n    checkboxEl.addEventListener('change', refreshPromoteSelectedCount);\n  });\n  refreshPromoteSelectedCount();\n\n  if (promoteSelectAllBtn) {\n    promoteSelectAllBtn.addEventListener('click', () => {\n      promoteCheckboxes().forEach((checkboxEl) => {\n        checkboxEl.checked = true;\n      });\n      refreshPromoteSelectedCount();\n    });\n  }\n\n  if (promoteClearAllBtn) {\n    promoteClearAllBtn.addEventListener('click', () => {\n      promoteCheckboxes().forEach((checkboxEl) => {\n        checkboxEl.checked = false;\n      });\n      refreshPromoteSelectedCount();\n    });\n  }\n\n  if (applyRecommendationsBtn) {\n    applyRecommendationsBtn.addEventListener('click', () => {\n      const selects = document.querySelectorAll('select[form=\"synonym-batch-form\"][data-recommended-action]');\n      let appliedCount = 0;\n      selects.forEach((selectEl) => {\n        if (!selectEl || selectEl.value) {\n          return;\n        }\n        const recommended = (selectEl.getAttribute('data-recommended-action') || '').trim();\n        if (!recommended) {\n          return;\n        }\n        if (recommended === 'approve' || recommended === 'defer' || recommended === 'reject') {\n          selectEl.value = recommended;\n          // Ensure UI listeners/paint update immediately in all browsers.\n          selectEl.dispatchEvent(new Event('input', { bubbles: true }));\n          selectEl.dispatchEvent(new Event('change', { bubbles: true }));\n          appliedCount += 1;\n        }\n      });\n      if (applyRecommendationsStatus) {\n        if (appliedCount > 0) {\n          applyRecommendationsStatus.textContent = `Filled ${appliedCount} recommended action(s).`;\n        } else {\n          applyRecommendationsStatus.textContent = \"No pending rows needed auto-fill.\";\n        }\n      }\n    });\n  }\n});\nif (document.readyState !== 'loading') {\n  window.setTimeout(() => ensureTabLoaded('enriched'), 50);\n}\n</script>\n\n  </div>\n  <script>\n  function applyTheme(t) {\n    document.documentElement.setAttribute('data-theme', t);\n    localStorage.setItem('fitcv-theme', t);\n    var icon  = document.getElementById('theme-icon');\n    var label = document.getElementById('theme-label');\n    if (icon && label) {\n      icon.textContent  = t === 'dark' ? '☀️' : '🌙';\n      label.textContent = t === 'dark' ? 'Light' : 'Dark';\n    }\n  }\n  function toggleTheme() {\n    applyTheme(\n      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'\n    );\n  }\n  // Sync toggle label on every page load\n  applyTheme(document.documentElement.getAttribute('data-theme') || 'dark');\n  </script>\n</body>\n</html>"
