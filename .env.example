# FitCV local Docker/runtime environment (public-safe example)
# Copy to .env locally and fill secrets.
# Routing owner: config/runtime/control_plane.yaml

# Sole repo-native LLM credential input
FITCV_LLM_API_KEY=your_llm_api_key_here

# Optional Compose host path for sibling LangGraph adapter checkout
# FITCV_LANGGRAPH_REPO_PATH=C:\path\to\fitcv-langgraph
