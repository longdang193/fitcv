{
  "source": "linkedin",
  "kind": "apify_actor",
  "actor": "valig/linkedin-jobs-scraper",
  "runs": [
    {
      "name": "student",
      "input": {
        "datePosted": "r86400",
        "easyApply": false,
        "keywords": "student",
