        "location": "Germany",
        "titleExclude": ["duales"],
        "titleInclude": ["AI"],
        "under10Applicants": false
      }
    },
    {
      "name": "Praktikum",
      "input": {
        "datePosted": "r86400",
        "easyApply": false,
        "keywords": "Praktikum",
        "limit": 100,
        "location": "Germany",
        "titleExclude": ["duales"],
        "under10Applicants": false
      }
    }
  ],
  "run": {
    "timeoutSecs": 300,
    "pollIntervalSecs": 2
  }
}
